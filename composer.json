{
    "name": "microscrap/ftdi",
    "description": "libFTDI Bindings for The PHP FTDI Extension",
    "type": "library",
    "version": "0.5.2",
    "keywords": ["framework", "scrapyard-io"],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ftdi": "^0.4.3|^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "Microscrap\\Bindings\\FTDI\\": "src/"
        },
        "files": [
            "src/Helpers/ftdi.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
